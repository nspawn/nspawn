[Unit]
Description=Docker API of nspawn for machine %i
Documentation=https://github.com/nspawn/nspawn
PartOf=nspawn-api@%i.socket
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/nspawn api-serve %i
# What a machine's clients can make it take of the host. Two runtime threads,
# whatever the host's CPUs: the rest of TasksMax is for journalctl and blocking reads.
Environment=TOKIO_WORKER_THREADS=2
TasksMax=64
MemoryMax=256M
LimitNOFILE=1024
