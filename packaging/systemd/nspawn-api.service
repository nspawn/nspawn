[Unit]
Description=Docker API of nspawn for the host
Documentation=https://nspawn.org/docs/docker-api/
PartOf=nspawn-api.socket
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/nspawn api-serve
# What the host's clients can make it take. Two runtime threads, whatever the host's
# CPUs, 16 log or event streams of users, 16 of root and 8 journal lookups at once fit
# in TasksMax.
Environment=TOKIO_WORKER_THREADS=2
TasksMax=96
MemoryMax=256M
LimitNOFILE=1024
