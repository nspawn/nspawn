# bom first
K_A=plain value # comment
K_B=value#nocomment
K_C="double \n escaped \t tab \\ backslash \$ dollar \" quote"
K_D='single \n $K_A ${K_A} \' q'
K_E="multi
line"
export K_F=exported
export   K_G  =  spaced
K_H: colon
K_I=${K_A}-${K_UNDEF:-def}-${K_UNDEF-d2}-${K_A:+alt}-${K_EMPTY:-e}
K_EMPTY=
K_J=${K_EMPTY:-x}${K_EMPTY-y}${K_EMPTY:+z}${K_EMPTY+w}
K_K="\0101\0\01\0400\0377\0189"
K_L="\c\x\qé\a\b\f\v\r"
K_M=  leading spaces
K_N=trailing spaces   
K_O="quoted" trailing
  K_P=indented
K_Q=a=b=c
K_R="${K_A}"
K_S='${K_A}'
K_T=$$K_A
K_U="\$K_A"
HOME
K_W=x #c # d
K_Y="a\
b"
K_Z = "spaced quoted"
K_AA=${K_A:-${K_UNDEF2}}
K_AB=${K_UNDEF3:-${K_A}}x}
K_AC=${K_UNDEF4:-{"json":1}}
K_AD=$K_A$K_B${K_C}
K_AF=""
K_AG=''
K_AH="#notcomment"
K_AI=val	# tabcomment
K_AJ=crlf
K_AK="crq"
export
K_AL=last