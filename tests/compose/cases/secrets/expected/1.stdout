name: secrets
services:
  app:
    configs:
      - source: app_config
      - source: from_env
        target: /etc/from_env
    image: alpine
    networks:
      default: null
    secrets:
      - source: db_password
        target: /run/secrets/db_password
      - source: api_key
        target: /etc/api_key
networks:
  default:
    name: secrets_default
secrets:
  api_key:
    name: secrets_api_key
    environment: API_KEY
  db_password:
    name: secrets_db_password
    file: /compose/secrets/db_password.txt
configs:
  app_config:
    name: secrets_app_config
    content: |
      key=value
      other=1
  from_env:
    name: secrets_from_env
    environment: CONFIG_VALUE
