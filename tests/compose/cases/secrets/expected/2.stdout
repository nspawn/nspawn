{
  "configs": {
    "app_config": {
      "name": "secrets_app_config",
      "content": "key=value\nother=1\n"
    },
    "from_env": {
      "name": "secrets_from_env",
      "environment": "CONFIG_VALUE"
    }
  },
  "name": "secrets",
  "networks": {
    "default": {
      "name": "secrets_default",
      "ipam": {}
    }
  },
  "secrets": {
    "api_key": {
      "name": "secrets_api_key",
      "environment": "API_KEY"
    },
    "db_password": {
      "name": "secrets_db_password",
      "file": "/compose/secrets/db_password.txt"
    }
  },
  "services": {
    "app": {
      "command": null,
      "configs": [
        {
          "source": "app_config"
        },
        {
          "source": "from_env",
          "target": "/etc/from_env"
        }
      ],
      "entrypoint": null,
      "image": "alpine",
      "networks": {
        "default": null
      },
      "secrets": [
        {
          "source": "db_password",
          "target": "/run/secrets/db_password"
        },
        {
          "source": "api_key",
          "target": "/etc/api_key"
        }
      ]
    }
  }
}