name: scalars
services:
  app:
    command:
      - echo
      - it's
      - <html>&
    image: alpine
    labels:
      bool: "true"
      colon: 'a: b'
      date: 2001-12-14 00:00:00 +0000 UTC
      empty: ""
      float: "1500"
      multiline: |
        line one
        line two
      number_string: "8080"
      octal: "493"
      sexagesimal: '1:30'
      tilde: ""
      yes_word: 'yes'
    networks:
      default: null
networks:
  default:
    name: scalars_default
