name: merge-merge-odd
services:
  db:
    image: alpine
    networks:
      default: null
  web:
    environment:
      A: map[b:1]
      C: "true"
      X: "1"
    image: alpine
    logging:
      driver: local
    networks:
      'n': null
    ulimits:
      nofile:
        soft: 1
        hard: 2
    build:
      context: /compose/merge-merge-odd
      dockerfile: Dockerfile
    depends_on:
      db:
        condition: service_started
        required: true
    ports:
      - mode: ingress
        target: 80
        protocol: tcp
networks:
  default:
    name: merge-merge-odd_default
  'n':
    name: merge-merge-odd_n
    ipam:
      config:
        - subnet: 10.0.0.0/24
