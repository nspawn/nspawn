{
 "architecture": "amd64",
 "config": {
  "Cmd": [
   "sh"
  ],
  "Env": [
   "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  ],
  "WorkingDir": "/app"
 },
 "history": [
  {
   "created_by": "BusyBox 1.37.0 (glibc), Debian 13"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "WORKDIR /app"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "COPY files/ ./"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "COPY --chmod=0750 run.sh /opt/bin/"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "COPY --chown=1000:1000 owned.txt /app/owned/"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "RUN /bin/sh -c echo \"made\" > /app/made && ln -s made /app/link && ln /app/made /app/hard && chmod 4755 /app/made"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "RUN /bin/sh -c rm /bin/vi /app/top.txt && mkdir -p /etc/opaque && echo a > /etc/opaque/a && echo changed >> /etc/hostname"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "RUN /bin/sh -c rm -rf /etc/opaque && mkdir /etc/opaque && echo b > /etc/opaque/b"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "RUN /bin/sh -c true"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "RUN /bin/sh -c set -e\necho heredoc > /app/heredoc\nmkfifo /app/fifo\n"
  },
  {
   "comment": "dockerfile.v0",
   "created_by": "COPY <<EOT /app/inline.txt"
  }
 ],
